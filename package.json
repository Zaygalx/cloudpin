{
  "name": "cloudpin",
  "version": "1.2.1",
  "description": "A seatbelt for your cloud CLIs: stops you, or your AI agent, from running commands on the wrong account.",
  "mcpName": "io.github.paureis/cloudpin",
  "type": "module",
  "bin": {
    "cloudpin": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "cloud",
    "cli",
    "azure",
    "aws",
    "gcloud",
    "vercel",
    "github",
    "kubernetes",
    "kubectl",
    "helm",
    "guardrails",
    "ai-agents",
    "claude-code",
    "cursor",
    "codex"
  ],
  "author": "Alvaro Reis",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paureis/cloudpin.git"
  },
  "homepage": "https://github.com/paureis/cloudpin#readme",
  "bugs": {
    "url": "https://github.com/paureis/cloudpin/issues"
  },
  "dependencies": {
    "cross-spawn": "7.0.6",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/cross-spawn": "6.0.6",
    "@types/node": "26.6.4",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
