{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.paureis/cloudpin",
  "title": "cloudpin",
  "description": "Read-only checks that cloud CLI commands run on the accounts a project pins in .cloudpin.yml.",
  "websiteUrl": "https://github.com/paureis/cloudpin/blob/main/docs/mcp.md",
  "repository": {
    "url": "https://github.com/paureis/cloudpin",
    "source": "github"
  },
  "version": "1.1.2",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "cloudpin",
      "version": "1.1.2",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
